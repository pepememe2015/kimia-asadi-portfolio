---
import { siteConfig } from "../config";

interface SkillItem {
  name: string;
  icon: string;
  level: number;
}

interface SkillCategory {
  title: string;
  skills: SkillItem[];
}

const categories: SkillCategory[] = siteConfig.skillCategories || [];
---

<section id="skills" class="py-16 sm:py-20 md:py-24 px-6 sm:px-10 md:px-16 lg:px-20 w-full relative">
  <div class="max-w-7xl mx-auto w-full">
    
    <!-- Section Header -->
    <div class="mb-12 sm:mb-16">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-[#3b2211]">
        مهارت‌ها & ابزارها
      </h2>
      <div
        class="w-[75px] h-[5px] mt-3 rounded-full"
        style={`background-color: ${siteConfig.accentColor}`}
      ></div>
    </div>

    <!-- Skill Categories Grid -->
    <div class="space-y-12 sm:space-y-16">
      {
        categories.map((category) => (
          <div class="space-y-6">
            
            <!-- Category Title Badge -->
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-[#805334]/15 border border-[#805334]/30 rounded-full text-[#3b2211] font-bold text-lg sm:text-xl shadow-xs">
                <span class="w-2.5 h-2.5 rounded-full bg-[#805334]"></span>
                {category.title}
              </span>
            </div>

            <!-- Skill Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
              {category.skills.map((skill) => (
                <div class="bg-[#f5e9dc]/80 hover:bg-[#fdfaf7] border border-[#805334]/25 hover:border-[#805334]/50 rounded-2xl p-5 sm:p-6 shadow-md shadow-[#805334]/10 hover:shadow-xl hover:shadow-[#805334]/15 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between gap-4 group">
                  
                  <!-- Card Top Row: Name, Percent, Icon -->
                  <div class="flex items-center justify-between gap-4 w-full">
                    
                    <!-- Title & Percentage Badge -->
                    <div class="flex items-center gap-3">
                      <span class="text-base sm:text-lg md:text-xl font-bold text-[#3b2211] group-hover:text-[#805334] transition-colors">
                        {skill.name}
                      </span>
                      <span class="text-xs sm:text-sm font-semibold text-[#805334] bg-[#805334]/10 border border-[#805334]/20 px-2.5 py-0.5 rounded-full">
                        {skill.level}٪
                      </span>
                    </div>

                    <!-- Tool Icon -->
                    <div class="p-2.5 bg-[#805334]/15 border border-[#805334]/30 text-[#805334] group-hover:bg-[#805334] group-hover:text-white rounded-xl shadow-xs transition-all duration-300 shrink-0">
                      {skill.icon === "palette" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.58 9 8a4.5 4.5 0 0 1 -7 3.6a2.5 2.5 0 0 0 -4 2.4c0 .88 .35 1.68 .9 2.25" />
                          <circle cx="7.5" cy="10.5" r=".5" fill="currentColor" />
                          <circle cx="12" cy="7.5" r=".5" fill="currentColor" />
                          <circle cx="16.5" cy="10.5" r=".5" fill="currentColor" />
                        </svg>
                      )}
                      {skill.icon === "pen" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 3l7 7l-9 9h-7v-7z" />
                          <path d="M16 5l3 3" />
                          <path d="M13.5 6.5l3 3" />
                        </svg>
                      )}
                      {skill.icon === "video" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="2" y="4" width="20" height="16" rx="2" />
                          <path d="M2 8h20" />
                          <path d="M6 4l2 4" />
                          <path d="M12 4l2 4" />
                          <path d="M18 4l2 4" />
                        </svg>
                      )}
                      {skill.icon === "figma" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H12v7H8.5A3.5 3.5 0 0 1 5 5.5z" />
                          <path d="M12 2h3.5a3.5 3.5 0 1 1 0 7H12V2z" />
                          <path d="M12 12.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 1 1 -7 0z" />
                          <path d="M5 19.5A3.5 3.5 0 0 1 8.5 16H12v3.5a3.5 3.5 0 1 1 -7 0z" />
                          <path d="M5 12.5A3.5 3.5 0 0 1 8.5 9H12v7H8.5A3.5 3.5 0 0 1 5 12.5z" />
                        </svg>
                      )}
                      {skill.icon === "brain" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 5a3 3 0 1 0 -5.997.125 4 4 0 0 0 -2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" />
                          <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1 -.556 6.588A4 4 0 1 1 12 18Z" />
                          <path d="M12 5v13" />
                        </svg>
                      )}
                      {skill.icon === "terminal" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 7l5 5l-5 5" />
                          <path d="M13 17h6" />
                        </svg>
                      )}
                      {skill.icon === "camera" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 7h1a2 2 0 0 0 2 -2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1a2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2" />
                          <circle cx="12" cy="13" r="3" />
                        </svg>
                      )}
                      {skill.icon === "vector" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="3" width="4" height="4" rx="1" />
                          <rect x="17" y="3" width="4" height="4" rx="1" />
                          <rect x="17" y="17" width="4" height="4" rx="1" />
                          <rect x="3" y="17" width="4" height="4" rx="1" />
                          <path d="M5 7v10" />
                          <path d="M7 5h10" />
                          <path d="M17 7v10" />
                          <path d="M7 17h10" />
                        </svg>
                      )}
                      {skill.icon === "book" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                          <path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                          <line x1="3" y1="6" x2="3" y2="19" />
                          <line x1="12" y1="6" x2="12" y2="19" />
                          <line x1="21" y1="6" x2="21" y2="19" />
                        </svg>
                      )}
                      {skill.icon === "brush" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 21v-4a4 4 0 1 1 4 4h-4z" />
                          <path d="M21 3a16 16 0 0 0 -12.8 10.2l2.6 2.6A16 16 0 0 0 21 3z" />
                        </svg>
                      )}
                      {skill.icon === "sparkles" && (
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0 -1.275 1.275L12 21l-1.912 -5.813a2 2 0 0 0 -1.275 -1.275L3 12l5.813 -1.912a2 2 0 0 0 1.275 -1.275L12 3z" />
                        </svg>
                      )}
                    </div>
                  </div>

                  <!-- Progress Bar Outer Track -->
                  <div class="w-full h-3.5 sm:h-4 bg-[#805334]/15 border border-[#805334]/30 rounded-full p-0.5 relative overflow-hidden">
                    <!-- Progress Bar Filled Inner Bar -->
                    <div
                      class="h-full rounded-full bg-gradient-to-r from-[#5c3a22] to-[#805334] transition-all duration-1000 ease-out shadow-xs"
                      style={`width: ${skill.level}%`}
                    ></div>
                  </div>

                </div>
              ))}
            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>
